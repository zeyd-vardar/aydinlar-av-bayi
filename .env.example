# Production URL settings. Root deployment uses / (or an unset base path).
PUBLIC_SITE_URL=https://trabzonavbayi.com
PUBLIC_BASE_PATH=/

# Optional, cookie-free Plausible-compatible analytics.
# The script is emitted only when this domain matches the active site hostname.
# On GitHub Pages, set these as repository variables named
# ANALYTICS_DOMAIN and ANALYTICS_SCRIPT_URL.
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
