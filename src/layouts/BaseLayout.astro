---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { siteConfig } from '../data/siteConfig.js';
import { serializeJsonLd } from '../utils/jsonLd';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  breadcrumbs?: { name: string; url: string }[];
  compactFooter?: boolean;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
  articleSection?: string;
  articleTags?: string[];
  includeLocalBusiness?: boolean;
  includeWebSite?: boolean;
  noindex?: boolean;
}
const {
  title,
  description,
  image = '/og.jpg',
  imageAlt = `${siteConfig.name} — ${siteConfig.tagline}`,
  breadcrumbs = [],
  compactFooter = false,
  ogType = 'website',
  publishedAt,
  updatedAt,
  author,
  articleSection,
  articleTags = [],
  includeLocalBusiness = false,
  includeWebSite = false,
  noindex = false,
} = Astro.props;
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, siteConfig.url);
const imageUrl = new URL(withBase(image), siteConfig.url);
const socialImageDetails: Record<
  string,
  { width: number; height: number; type: `image/${string}` }
> = {
  '/og.jpg': { width: 1200, height: 627, type: 'image/jpeg' },
  '/images/category-atlas.jpg': { width: 2000, height: 711, type: 'image/jpeg' },
  '/images/hero-fishing.jpg': { width: 1920, height: 1080, type: 'image/jpeg' },
  '/images/hunting-banner.jpg': { width: 1920, height: 800, type: 'image/jpeg' },
};
const socialImage = socialImageDetails[image];
const logoUrl = new URL(withBase(siteConfig.logoPath), siteConfig.url).href;
const logoImage = {
  '@type': 'ImageObject',
  url: logoUrl,
  width: siteConfig.logo.width,
  height: siteConfig.logo.height,
  encodingFormat: siteConfig.logo.type,
};
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'SportingGoodsStore',
  '@id': `${siteConfig.url}#store`,
  name: siteConfig.name,
  legalName: siteConfig.legalName,
  description: siteConfig.tagline,
  url: siteConfig.url,
  telephone: siteConfig.phoneHref,
  email: siteConfig.email,
  image: imageUrl.href,
  logo: logoImage,
  address: {
    '@type': 'PostalAddress',
    ...siteConfig.addressDetails,
  },
  hasMap: siteConfig.mapUrl,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: siteConfig.openingHours.opens,
      closes: siteConfig.openingHours.closes,
    },
  ],
  sameAs: Object.values(siteConfig.socials).filter((url) => url !== '#'),
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteConfig.url}#website`,
  name: siteConfig.name,
  url: siteConfig.url,
  publisher: { '@id': `${siteConfig.url}#store` },
};
const breadcrumbSchema = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        item: new URL(withBase(item.url), siteConfig.url).href,
      })),
    }
  : null;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="theme-color"
      content="#292826"
    />
    <meta
      name="referrer"
      content="strict-origin-when-cross-origin"
    />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    {
      noindex && (
        <meta
          name="robots"
          content="noindex, follow"
        />
      )
    }
    <link
      rel="canonical"
      href={canonical}
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBase('/favicon.svg')}
    />
    <link
      rel="apple-touch-icon"
      href={withBase(siteConfig.logoPath)}
    />
    <meta
      property="og:type"
      content={ogType}
    />
    <meta
      property="og:locale"
      content="tr_TR"
    />
    <meta
      property="og:site_name"
      content={siteConfig.name}
    />
    <meta
      property="og:title"
      content={title}
    />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:url"
      content={canonical}
    />
    <meta
      property="og:image"
      content={imageUrl.href}
    />
    <meta
      property="og:image:url"
      content={imageUrl.href}
    />
    {
      imageUrl.protocol === 'https:' && (
        <meta
          property="og:image:secure_url"
          content={imageUrl.href}
        />
      )
    }
    {
      socialImage && (
        <>
          <meta
            property="og:image:type"
            content={socialImage.type}
          />
          <meta
            property="og:image:width"
            content={String(socialImage.width)}
          />
          <meta
            property="og:image:height"
            content={String(socialImage.height)}
          />
        </>
      )
    }
    <meta
      property="og:image:alt"
      content={imageAlt}
    />
    {
      ogType === 'article' && publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    {
      ogType === 'article' && updatedAt && (
        <meta
          property="article:modified_time"
          content={updatedAt.toISOString()}
        />
      )
    }
    {
      ogType === 'article' && author && (
        <meta
          name="author"
          content={author}
        />
      )
    }
    {
      ogType === 'article' && articleSection && (
        <meta
          property="article:section"
          content={articleSection}
        />
      )
    }
    {
      ogType === 'article' &&
        articleTags.map((tag) => (
          <meta
            property="article:tag"
            content={tag}
          />
        ))
    }
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content={title}
    />
    <meta
      name="twitter:description"
      content={description}
    />
    <meta
      name="twitter:image"
      content={imageUrl.href}
    />
    <meta
      name="twitter:image:alt"
      content={imageAlt}
    />
    <slot name="head" />
    {
      includeLocalBusiness && (
        <script
          type="application/ld+json"
          set:html={serializeJsonLd(localBusiness)}
        />
      )
    }
    {
      includeWebSite && (
        <script
          type="application/ld+json"
          set:html={serializeJsonLd(websiteSchema)}
        />
      )
    }
    {
      breadcrumbSchema && (
        <script
          type="application/ld+json"
          set:html={serializeJsonLd(breadcrumbSchema)}
        />
      )
    }
  </head>
  <body>
    <a
      class="skip-link"
      href="#icerik"
      >İçeriğe geç</a
    >
    <Header />
    <main id="icerik"><slot /></main>
    <Footer compact={compactFooter} />
    <WhatsAppButton />
  </body>
</html>
