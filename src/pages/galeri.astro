---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
const crumbs = [{name:'Ana Sayfa',url:'/'},{name:'Galeri',url:'/galeri'}];
const items = ['Mağazamız','Balıkçılık Dünyası','Outdoor Seçkisi','Avcılık Ekipmanları','Kamp Hazırlığı','Detaylar'];
---
<BaseLayout title="Galeri | Aydınlar Av Bayi" description="Mağazamızdan, balıkçılık ve avcılık ürün gruplarımızdan, outdoor ve kamp dünyasından kareleri inceleyin." breadcrumbs={crumbs} compactFooter>
  <PageHero eyebrow="Galeri" title="Mağazadan ve doğadan kareler" text="Ekipman, mağaza ve açık hava dünyamızı yakından keşfedin." image="/images/hero-fishing.jpg" position="center 60%" />
  <section class="section"><div class="container"><SectionHeader eyebrow="Görsel Günlük" title="Tutkunun ayrıntılarına yakından bakın" text="Mağaza atmosferinden açık havadaki kullanım anlarına uzanan seçkimiz."/><div class="gallery-grid">{items.map((item, index) => <div class={`gallery-item gallery-item-${index + 1}`} role="img" aria-label={`${item} fotoğrafı`}><span>{item}</span></div>)}</div></div></section>
</BaseLayout>
