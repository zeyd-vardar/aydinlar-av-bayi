---
import { siteConfig } from '../../data/siteConfig.js';
import { withBase } from '../../utils/paths';

const canonical = new URL(withBase('/panel/'), siteConfig.url).href;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="robots"
      content="noindex, nofollow, noarchive"
    />
    <meta
      name="referrer"
      content="no-referrer"
    />
    <link
      rel="canonical"
      href={canonical}
    />
    <title>Yönetici Paneli Önizlemesi | {siteConfig.name}</title>
    <meta
      name="description"
      content="Aydınlar yönetici panelinin geçici ve işlevsiz arayüz önizlemesi."
    />
  </head>
  <body>
    <main>
      <section
        class="login-preview"
        aria-labelledby="login-title"
      >
        <div
          class="preview-notice"
          role="note"
        >
          <strong>Geçici GitHub Pages önizlemesi</strong>
          <span>Bu statik sayfada giriş ve veri değiştirme işlemleri devre dışıdır.</span>
        </div>

        <div class="auth-card">
          <div class="panel-brand">AYDINLAR <span>Yönetim</span></div>
          <h1 id="login-title">Yönetici Girişi</h1>
          <p>Devam etmek için yönetici hesabınızla giriş yapın.</p>
          <div
            class="stack-form"
            aria-label="Devre dışı giriş formu"
          >
            <label>
              E-posta
              <input
                type="email"
                placeholder="info@aydinlarav.com"
                disabled
              />
            </label>
            <label>
              Şifre
              <input
                type="password"
                value="preview-password"
                disabled
              />
            </label>
            <button
              class="primary-button"
              type="button"
              disabled
            >
              Giriş Yap
            </button>
          </div>
          <a
            class="preview-link"
            href="#dashboard-preview"
          >
            Dashboard görünümünü incele
          </a>
        </div>
      </section>

      <section
        class="dashboard-preview"
        id="dashboard-preview"
        aria-labelledby="dashboard-title"
      >
        <aside class="sidebar">
          <div class="panel-brand light">AYDINLAR <span>Yönetim</span></div>
          <nav aria-label="Önizleme menüsü">
            <a
              href="#dashboard-preview"
              aria-current="page"
            >Genel Bakış</a>
            <a href="#products-preview">Ürünler</a>
            <span>Şifre Değiştir</span>
          </nav>
          <span class="logout-preview">Çıkış Yap</span>
        </aside>

        <div class="panel-content">
          <div class="preview-label">Arayüz önizlemesi · İşlemler devre dışı</div>
          <header class="panel-header">
            <h2 id="dashboard-title">Genel Bakış</h2>
          </header>
          <div class="stats-grid">
            <article><span>Toplam ürün</span><strong>0</strong></article>
            <article><span>Önerilen ürün</span><strong>0</strong></article>
            <article><span>Yeni gelen ürün</span><strong>0</strong></article>
          </div>
          <div class="content-card detail-list">
            <p><span>Son ürün güncellemesi</span><strong>Henüz ürün yok</strong></p>
            <p><span>Yönetici hesabı</span><strong>info@aydinlarav.com</strong></p>
          </div>

          <section
            class="products-preview"
            id="products-preview"
            aria-labelledby="products-title"
          >
            <div class="content-heading">
              <h2 id="products-title">Ürünler</h2>
              <span class="primary-button disabled">Yeni Ürün Ekle</span>
            </div>
            <div class="content-card empty-products">
              <strong>Henüz ürün eklenmedi.</strong>
              <p>Önerilen ve yeni gelen ürünler bu alandan yönetilecek.</p>
            </div>
          </section>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --forest: #17251c;
    --forest-soft: #24362a;
    --paper: #f5f3ed;
    --white: #fff;
    --ink: #19221c;
    --muted: #667069;
    --line: #d9d8d1;
    --gold: #b9781d;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
  }

  a {
    color: inherit;
  }

  button,
  input {
    font: inherit;
  }

  .login-preview {
    min-height: 100svh;
    padding: 88px 24px 40px;
    display: grid;
    place-items: center;
    position: relative;
    background: var(--forest);
  }

  .preview-notice {
    position: absolute;
    top: 20px;
    left: 50%;
    width: min(680px, calc(100% - 32px));
    padding: 12px 16px;
    display: flex;
    justify-content: center;
    gap: 8px 14px;
    flex-wrap: wrap;
    transform: translateX(-50%);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.76);
    background: rgba(255, 255, 255, 0.07);
    font-size: 0.78rem;
    text-align: center;
  }

  .preview-notice strong {
    color: white;
  }

  .auth-card {
    width: min(100%, 430px);
    padding: 36px;
    border-radius: 10px;
    background: var(--white);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.25);
  }

  .panel-brand {
    font-weight: 850;
    letter-spacing: 0.09em;
  }

  .panel-brand span {
    display: block;
    margin-top: 4px;
    color: var(--gold);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .panel-brand.light {
    color: white;
  }

  h1 {
    margin: 28px 0 8px;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.65rem, 3vw, 2.25rem);
  }

  p {
    color: var(--muted);
    line-height: 1.65;
  }

  .stack-form {
    margin-top: 24px;
    display: grid;
    gap: 18px;
  }

  label {
    display: grid;
    gap: 7px;
    font-size: 0.82rem;
    font-weight: 750;
  }

  input {
    width: 100%;
    min-height: 46px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #f2f2ee;
  }

  .primary-button {
    min-height: 44px;
    padding: 11px 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 5px;
    color: white;
    background: var(--forest);
    font-weight: 750;
    text-decoration: none;
  }

  button.primary-button:disabled,
  .primary-button.disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .preview-link {
    margin-top: 22px;
    display: inline-block;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .dashboard-preview {
    min-height: 100svh;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    scroll-margin-top: 0;
  }

  .sidebar {
    min-height: 100svh;
    padding: 28px 22px;
    display: flex;
    flex-direction: column;
    color: white;
    background: var(--forest);
  }

  .sidebar nav {
    margin: 42px 0 auto;
    display: grid;
    gap: 6px;
  }

  .sidebar nav a,
  .sidebar nav span,
  .logout-preview {
    padding: 11px 12px;
    border-radius: 5px;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
  }

  .sidebar nav a[aria-current="page"] {
    color: white;
    background: var(--forest-soft);
  }

  .sidebar nav span,
  .logout-preview {
    opacity: 0.58;
  }

  .panel-content {
    min-width: 0;
    padding: 38px;
  }

  .preview-label {
    width: fit-content;
    margin-bottom: 20px;
    padding: 7px 10px;
    border-radius: 4px;
    color: #80530f;
    background: #f3e3c8;
    font-size: 0.72rem;
    font-weight: 750;
  }

  .panel-header {
    margin-bottom: 28px;
  }

  .stats-grid {
    margin-bottom: 20px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .stats-grid article,
  .content-card {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--white);
  }

  .stats-grid span {
    display: block;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .stats-grid strong {
    margin-top: 8px;
    display: block;
    font-size: 2rem;
  }

  .detail-list p {
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  .detail-list p + p {
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid var(--line);
  }

  .detail-list strong {
    color: var(--ink);
    text-align: right;
  }

  .products-preview {
    padding-top: 72px;
  }

  .content-heading {
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .empty-products {
    text-align: center;
  }

  .empty-products p {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .login-preview {
      padding-inline: 16px;
    }

    .auth-card {
      padding: 28px 22px;
    }

    .dashboard-preview {
      grid-template-columns: 1fr;
    }

    .sidebar {
      min-height: auto;
      padding: 18px;
    }

    .sidebar nav {
      margin: 22px 0 14px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .logout-preview {
      padding-top: 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .panel-content {
      padding: 24px 16px 40px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .detail-list p {
      display: grid;
      gap: 4px;
    }

    .detail-list strong {
      text-align: left;
    }

    .content-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
