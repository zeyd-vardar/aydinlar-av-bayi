---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/categories.js';
import { brands } from '../data/brands.js';
import { siteConfig } from '../data/siteConfig.js';
const features = [
  ['01','Güvenilir Markalar','Dünyaca ünlü markalar tek çatı altında.'],
  ['02','Uzman Destek','Tecrübeli ekibimiz her zaman yanınızda.'],
  ['03','Geniş Ürün Yelpazesi','Balıkçılık, avcılık, outdoor ve daha fazlası.'],
  ['04','Kolay Ulaşım','Mağazamıza kolayca ulaşabilirsiniz.']
];
---
<BaseLayout title="Aydınlar Av Bayi | Balıkçılık, Avcılık ve Outdoor" description="Balıkçılık, avcılık, kamp ve outdoor ekipmanlarında geniş ürün yelpazesi, güvenilir markalar ve uzman destek için mağazamızı keşfedin.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-copy">
      <span class="eyebrow light">Doğada daima daha fazlası</span>
      <h1 id="hero-title">Balıkçılık Bir <em>Tutkudur</em></h1>
      <p>Denizde, gölde, nehirde… Tüm balıkçılık ve avcılık ihtiyaçlarınız için deneyimimizle yanınızdayız.</p>
      <div class="hero-actions"><a class="btn btn-gold" href="/urun-gruplari">Ürün Gruplarını Keşfet <Icon name="arrow" size={18}/></a><a class="btn btn-outline" href="/iletisim">Mağazamız</a></div>
    </div>
    <span class="hero-side-note">KEŞFETMEK İÇİN KAYDIR</span>
  </section>

  <section class="section" aria-labelledby="categories-title"><div class="container">
    <SectionHeader eyebrow="Ürün Dünyamız" title="Doğadaki her plan için doğru ekipman" text="İhtiyacınızı kolayca bulun, ürünleri yakından görmek ve uzman görüşü almak için mağazamızı ziyaret edin." />
    <div class="categories-grid">{categories.map((category) => <CategoryCard category={category} />)}</div>
  </div></section>

  <section class="section alt" aria-labelledby="brands-title"><div class="container">
    <SectionHeader eyebrow="Seçkin Markalar" title="Güvendiğiniz isimler, aynı çatı altında" text="Farklı kullanım seviyelerine ve ihtiyaçlara hitap eden dünya markalarını yerinde inceleyin." />
    <div class="brands-row">{brands.map((brand) => <div class="brand-tile">{brand}</div>)}</div>
    <p style="margin:32px 0 0"><a class="text-link" href="/markalar">Tüm markaları keşfet <Icon name="arrow" size={17}/></a></p>
  </div></section>

  <section class="store-split" aria-labelledby="store-title">
    <div class="store-visual" role="img" aria-label="Aydınlar Av Bayi mağaza içi görsel alanı"></div>
    <div class="store-content"><span class="eyebrow light">Mağazamız</span><h2 id="store-title">Tutkunuzu Yerinde Deneyimleyin</h2><p>Balıkçılık ve avcılık ekipmanlarında geniş ürün yelpazemiz, uzman ekibimiz ve samimi mağaza ortamımız ile hizmetinizdeyiz. Ürünleri yerinde inceleyebilir, ihtiyacınıza en uygun ekipmanı seçerken profesyonel destek alabilirsiniz.</p><a class="btn btn-gold" href="/iletisim">Mağazamızı Ziyaret Edin <Icon name="arrow" size={18}/></a></div>
  </section>

  <section class="hunt-banner" aria-labelledby="hunt-title"><div class="container"><div class="content"><span class="eyebrow light">Doğaya hazır olun</span><h2 id="hunt-title">Avcılıkta Doğayla Biriz</h2><p>Doğada güvenle ve özgürce zaman geçirmeniz için kaliteli avcılık ekipmanları mağazamızda.</p><a class="btn btn-gold" href="/urun-gruplari#avcilik">Avcılık Ürünlerini İncele <Icon name="arrow" size={18}/></a></div></div></section>

  <section class="section" aria-labelledby="why-title"><div class="container"><SectionHeader eyebrow="Neden Aydınlar" title="Ekipmandan fazlası: deneyim ve güven" align="center"/><div class="features-grid">{features.map(([num,title,text]) => <article class="feature"><span class="feature-num">{num}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

  <section class="section alt"><div class="container contact-band"><div><span class="eyebrow">Bize Ulaşın</span><h2>Doğru ekipmanı birlikte seçelim.</h2><p>Sorularınız, ürün bilgisi ve mağaza ziyareti için bize telefon veya WhatsApp üzerinden kolayca ulaşın.</p></div><div class="contact-actions"><a class="btn btn-dark" href={`tel:${siteConfig.phoneHref}`}><Icon name="phone"/> {siteConfig.phone}</a><a class="btn btn-gold" href={`https://wa.me/${siteConfig.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp"/> WhatsApp ile İletişime Geç</a></div></div></section>
</BaseLayout>
