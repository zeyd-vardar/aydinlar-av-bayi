---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Icon from '../components/Icon.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import { categories } from '../data/categories.js';
import { brands } from '../data/brands.js';
const features = [
  ['shield','Güvenilir Markalar','Dünyaca ünlü markalar tek çatı altında.'],
  ['users','Uzman Destek','Tecrübeli ekibimiz her zaman yanınızda.'],
  ['settings','Geniş Ürün Yelpazesi','Balıkçılık, avcılık, outdoor ve daha fazlası.'],
  ['pin','Kolay Ulaşım','Merkezi konumda rahat erişim.']
] as const;
const homePosts = (await getCollection('blog')).filter((post) => post.data.featured).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).slice(0,3);
---
<BaseLayout title="Aydınlar Av Bayi | Balıkçılık, Avcılık ve Outdoor" description="Balıkçılık, avcılık, kamp ve outdoor ekipmanlarında geniş ürün yelpazesi, güvenilir markalar ve uzman destek için mağazamızı keşfedin." compactFooter>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero-image" src="/images/hero-fishing.jpg" alt="Gün batımında kayalık kıyıda olta atan balıkçı" width="1920" height="1004" fetchpriority="high" />
    <div class="container hero-copy">
      <span class="eyebrow light">Doğada daima daha fazlası</span>
      <h1 id="hero-title">Balıkçılık<br/>Bir Tutkudur</h1>
      <p>Denizde, gölde, nehirde…<br/>Tüm balıkçılık ve avcılık ihtiyaçlarınız için yanınızdayız.</p>
      <div class="hero-actions"><a class="btn btn-light" href="/urun-gruplari">Ürün Gruplarını Keşfet <Icon name="arrow" size={18}/></a><a class="btn btn-outline" href="/iletisim">Mağazamız <Icon name="arrow" size={18}/></a></div>
    </div>
    <div class="hero-pagination" aria-hidden="true"><span></span><span></span><span></span></div>
  </section>

  <section class="home-categories" aria-label="Ürün kategorileri"><div class="container">
    <div class="categories-grid">{categories.map((category) => <CategoryCard category={category} />)}</div>
  </div></section>

  <section class="home-brands" aria-labelledby="brands-title"><div class="container">
    <p class="brands-label" id="brands-title">Çalıştığımız Markalar</p>
    <div class="brands-marquee"><span aria-hidden="true">‹</span>{brands.map((brand) => <a href="/markalar">{brand}</a>)}<span aria-hidden="true">›</span></div>
  </div></section>

  <section class="store-split" aria-labelledby="store-title">
    <img class="store-visual" src="/images/store-interior.jpg" alt="Balıkçılık ve outdoor ürünlerinin sergilendiği modern mağaza içi" width="1400" height="933" loading="lazy" />
    <div class="store-content"><span class="eyebrow">Mağazamız</span><h2 id="store-title">Tutkunuzu<br/>Yerinde Deneyimleyin</h2><p>Balıkçılık ve avcılık ekipmanlarında geniş ürün yelpazemiz, uzman ekibimiz ve samimi mağaza ortamımız ile hizmetinizdeyiz. Ürünleri yerinde inceleyebilir, ihtiyacınıza en uygun ekipmanı seçerken profesyonel destek alabilirsiniz.</p><a class="btn btn-dark" href="/iletisim">Mağazamızı Ziyaret Edin <Icon name="arrow" size={18}/></a></div>
  </section>

  <section class="hunt-banner" aria-labelledby="hunt-title"><div class="container"><div class="content"><h2 id="hunt-title">Avcılıkta<br/>Doğayla Biriz</h2><p>Doğada güvenle ve özgürce zaman geçirmeniz için kaliteli avcılık ekipmanları mağazamızda.</p><a class="btn btn-light" href="/urun-gruplari#avcilik">Avcılık Ürünlerini İncele <Icon name="arrow" size={18}/></a></div></div></section>

  <section class="home-blog"><div class="container"><div class="home-blog-head"><div><span class="eyebrow">Bilgi Merkezi</span><h2>Doğaya Dair Bilgi Rehberi</h2><p>Balıkçılık, avcılık ve kampçılık hakkında faydalı rehberler.</p></div><a class="text-link" href="/blog">Tüm Yazıları Gör <Icon name="arrow" size={16}/></a></div><div class="blog-grid compact">{homePosts.map((post,index) => <BlogCard post={post} index={index}/>)}</div></div></section>

  <section class="home-features" aria-label="Mağaza avantajları"><div class="container"><div class="features-grid">{features.map(([icon,title,text]) => <article class="feature"><span class="feature-icon"><Icon name={icon} size={28}/></span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
</BaseLayout>
