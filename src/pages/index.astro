---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/categories.js';
import { brandGroups } from '../data/brands.js';
import { withBase } from '../utils/paths';
const brands = [...new Set(brandGroups.flatMap((group) => group.brands))];
const features = [
  ['shield', 'Güvenilir Markalar', 'Dünyaca ünlü markalar tek çatı altında.'],
  ['users', 'Uzman Destek', 'Tecrübeli ekibimiz her zaman yanınızda.'],
  ['settings', 'Geniş Ürün Yelpazesi', 'Balıkçılık, avcılık, outdoor ve daha fazlası.'],
  ['pin', 'Kolay Ulaşım', 'Merkezi konumda rahat erişim.'],
] as const;
const heroSlides = [
  {
    category: 'Balıkçılık',
    eyebrow: 'Doğada daima daha fazlası',
    title: 'Balıkçılık',
    accent: 'Bir Tutkudur',
    text: 'Denizde, gölde, nehirde… Doğru ekipmanla her atış yeni bir heyecana dönüşür.',
    href: '/urun-gruplari#balikcilik',
    cta: 'Balıkçılık Ürünleri',
    image: '/images/hero-fishing.webp',
    width: 1920,
    height: 1080,
    imageClass: 'hero-image-fishing',
    alt: 'Gün batımında kayalık kıyıda olta atan balıkçı',
  },
  {
    category: 'Avcılık',
    eyebrow: 'Güven, deneyim ve hazırlık',
    title: 'Avcılık',
    accent: 'Doğayla Bir Bütündür',
    text: 'Doğaya saygılı, güvenli ve hazırlıklı bir deneyim için aradığınız ekipmanlar burada.',
    href: '/urun-gruplari#avcilik',
    cta: 'Avcılık Ürünleri',
    image: '/images/hunting-banner.webp',
    width: 1920,
    height: 800,
    imageClass: 'hero-image-hunting',
    alt: 'Dağlık arazide avcılık yapan doğa tutkunu',
  },
  {
    category: 'Outdoor',
    eyebrow: 'Her adımda daha ileri',
    title: 'Outdoor',
    accent: 'Her Koşula Hazır',
    text: 'Değişen hava ve arazi koşullarında konforunuzu koruyan dayanıklı outdoor ürünlerini keşfedin.',
    href: '/urun-gruplari#outdoor',
    cta: 'Outdoor Ürünleri',
    image: '/images/hero-outdoor.webp',
    width: 1672,
    height: 941,
    imageClass: 'hero-image-outdoor',
    alt: 'Dağ manzarasında yürüyüş yapan iki outdoor tutkunu',
  },
  {
    category: 'Kamp',
    eyebrow: 'Doğada kendi alanınızı kurun',
    title: 'Kamp',
    accent: 'Özgürlüğün Kendisi',
    text: 'Çadırdan aydınlatmaya, açık havada konforlu ve keyifli bir düzen için ihtiyacınız olan her şey.',
    href: '/urun-gruplari#kamp',
    cta: 'Kamp Ürünleri',
    image: '/images/hero-camp.webp',
    width: 1672,
    height: 941,
    imageClass: 'hero-image-camp',
    alt: 'Gün batımında dağ kampı, çadır ve kamp ateşi',
  },
] as const;
---

<BaseLayout
  title="Aydınlar Av Bayii | Balıkçılık, Avcılık ve Kamp"
  description="Trabzon Ortahisar'da balıkçılık, avcılık ve kamp ekipmanları; güvenilir markalar ve ürün seçimine yardımcı uzman destek için Aydınlar Av Bayii'ni keşfedin."
  includeWebSite
  compactFooter
>
  <section
    class="hero"
    aria-roledescription="carousel"
    aria-label="Ürün kategorileri"
    data-hero-carousel
  >
    <div
      class="hero-track"
      data-hero-track
    >
      {
        heroSlides.map((slide, index) => (
          <article
            class="hero-slide"
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} / ${heroSlides.length}: ${slide.category}`}
            aria-hidden={index === 0 ? 'false' : 'true'}
            data-hero-slide
          >
            <img
              class:list={['hero-image', slide.imageClass]}
              src={withBase(slide.image)}
              alt={slide.alt}
              width={slide.width}
              height={slide.height}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'low'}
              decoding="async"
            />
            <div class="container hero-copy">
              <span class="eyebrow light">{slide.eyebrow}</span>
              {index === 0 ? (
                <h1 id="hero-title">
                  {slide.title}
                  <br />
                  {slide.accent}
                </h1>
              ) : (
                <h2>
                  {slide.title}
                  <br />
                  {slide.accent}
                </h2>
              )}
              <p>{slide.text}</p>
              <div class="hero-actions">
                <a
                  class="btn btn-light"
                  href={withBase(slide.href)}
                >
                  {slide.cta}{' '}
                  <Icon
                    name="arrow"
                    size={18}
                  />
                </a>
                <a
                  class="btn btn-outline"
                  href={withBase('/magazamiz')}
                >
                  Mağazamız{' '}
                  <Icon
                    name="arrow"
                    size={18}
                  />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
    <div class="hero-controls">
      <button
        class="hero-arrow"
        type="button"
        aria-label="Önceki kategori"
        data-hero-prev
        ><span aria-hidden="true">←</span></button
      >
      <div
        class="hero-pagination"
        aria-label="Kategori seçin"
      >
        {
          heroSlides.map((slide, index) => (
            <button
              type="button"
              aria-label={`${slide.category} slaydını göster`}
              aria-current={index === 0 ? 'true' : undefined}
              data-hero-dot
            />
          ))
        }
      </div>
      <button
        class="hero-arrow"
        type="button"
        aria-label="Sonraki kategori"
        data-hero-next
        ><span aria-hidden="true">→</span></button
      >
    </div>
    <p
      class="sr-only"
      aria-live="polite"
      aria-atomic="true"
      data-hero-status
    >
    </p>
  </section>

  <section
    class="home-categories"
    aria-label="Ürün kategorileri"
  >
    <div class="container">
      <div class="categories-grid">
        {categories.map((category) => <CategoryCard category={category} />)}
      </div>
    </div>
  </section>

  <section
    class="home-brands"
    aria-labelledby="brands-title"
  >
    <div class="container">
      <p
        class="brands-label"
        id="brands-title"
      >
        Çalıştığımız Markalar
      </p>
      <div class="brands-marquee">
        <div
          class="brands-marquee-track"
          style={`--brands-duration:${brands.length * 4}s`}
        >
          <div class="brands-marquee-group">
            {brands.map((brand) => <a href={withBase('/markalar')}>{brand}</a>)}
          </div>
          <div
            class="brands-marquee-group brands-marquee-copy"
            aria-hidden="true"
          >
            {
              brands.map((brand) => (
                <a
                  href={withBase('/markalar')}
                  tabindex="-1"
                >
                  {brand}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="store-showcase"
    aria-labelledby="store-title"
  >
    <div class="container">
      <div class="store-frame">
        <img
          class="store-visual"
          src={withBase('/images/aydinlar-magaza.webp')}
          alt="Aydınlar Av Bayii mağazasının turuncu tabelalı gerçek dış cephesi"
          width="1682"
          height="784"
          loading="lazy"
          decoding="async"
        />
        <div class="store-content">
          <h2 id="store-title">Tutkunuzu<br />Yerinde Deneyimleyin</h2><p>
            Balıkçılık, avcılık ve outdoor ekipmanlarını yakından inceleyin; ihtiyacınıza uygun
            ürünü seçerken deneyimli ekibimizden destek alın.
          </p><a
            class="btn btn-dark"
            href={withBase('/iletisim')}
            >Mağazamızı Ziyaret Edin <Icon
              name="arrow"
              size={18}
            /></a
          >
        </div>
      </div>
    </div>
  </section>

  <section
    class="hunt-banner"
    aria-labelledby="hunt-title"
  >
    <div class="container">
      <div class="content">
        <h2 id="hunt-title">Avcılıkta<br />Doğayla Biriz</h2><p>
          Doğada güvenle ve özgürce zaman geçirmeniz için kaliteli avcılık ekipmanları mağazamızda.
        </p><a
          class="btn btn-light"
          href={withBase('/urun-gruplari#avcilik')}
          >Avcılık Ürünlerini İncele <Icon
            name="arrow"
            size={18}
          /></a
        >
      </div>
    </div>
  </section>

  <section class="home-knowledge">
    <div class="container">
      <div class="home-knowledge-head">
        <span class="eyebrow">BLOG</span><h2>Doğaya Dair BLOG</h2><p>
          Balıkçılık, avcılık ve kampçılık hakkında merak ettiğiniz bilgilere ulaşın.
        </p>
      </div><nav
        class="home-knowledge-links"
        aria-label="BLOG kategorileri"
      >
        <a href={withBase('/blog?category=balikcilik')}
          ><span>01</span><strong>Balıkçılık</strong><b aria-hidden="true">→</b></a
        ><a href={withBase('/blog?category=avcilik')}
          ><span>02</span><strong>Avcılık</strong><b aria-hidden="true">→</b></a
        ><a href={withBase('/blog?category=kampcilik')}
          ><span>03</span><strong>Kampçılık</strong><b aria-hidden="true">→</b></a
        >
      </nav><a
        class="btn btn-dark"
        href={withBase('/blog')}
        >Tüm Bilgilere Ulaş <Icon
          name="arrow"
          size={18}
        /></a
      >
    </div>
  </section>

  <section
    class="home-features"
    aria-label="Mağaza avantajları"
  >
    <div class="container">
      <div class="features-grid">
        {
          features.map(([icon, title, text]) => (
            <article class="feature">
              <span class="feature-icon">
                <Icon
                  name={icon}
                  size={28}
                />
              </span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <script>
    function initializeHeroCarousel() {
      const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
      if (!carousel) return;

      const track = carousel.querySelector<HTMLElement>('[data-hero-track]');
      const slides = [...carousel.querySelectorAll<HTMLElement>('[data-hero-slide]')];
      if (!track || slides.length === 0) return;

      const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
      const previousButton = carousel.querySelector<HTMLButtonElement>('[data-hero-prev]');
      const nextButton = carousel.querySelector<HTMLButtonElement>('[data-hero-next]');
      const status = carousel.querySelector<HTMLElement>('[data-hero-status]');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let activeIndex = 0;
      let autoplayTimer: number | undefined;
      let pointerStartX: number | undefined;

      const showSlide = (index: number, announce = false) => {
        activeIndex = (index + slides.length) % slides.length;
        track.style.transform = `translate3d(-${activeIndex * 100}%, 0, 0)`;

        slides.forEach((slide, index) => {
          const isActive = index === activeIndex;
          slide.setAttribute('aria-hidden', String(!isActive));
          slide.toggleAttribute('inert', !isActive);
        });

        dots.forEach((dot, index) => {
          if (index === activeIndex) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });

        if (announce && status) {
          status.textContent = slides[activeIndex].getAttribute('aria-label') ?? '';
        }
      };

      const stopAutoplay = () => {
        window.clearTimeout(autoplayTimer);
        autoplayTimer = undefined;
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (prefersReducedMotion || document.hidden) return;

        autoplayTimer = window.setTimeout(() => {
          showSlide(activeIndex + 1);
          startAutoplay();
        }, 5000);
      };

      const selectSlide = (index: number) => {
        showSlide(index, true);
        startAutoplay();
      };

      previousButton?.addEventListener('click', () => selectSlide(activeIndex - 1));
      nextButton?.addEventListener('click', () => selectSlide(activeIndex + 1));
      dots.forEach((dot, index) => dot.addEventListener('click', () => selectSlide(index)));

      carousel.addEventListener('focusin', stopAutoplay);
      carousel.addEventListener('focusout', (event) => {
        if (!carousel.contains(event.relatedTarget as Node | null)) startAutoplay();
      });
      carousel.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') selectSlide(activeIndex - 1);
        if (event.key === 'ArrowRight') selectSlide(activeIndex + 1);
      });
      carousel.addEventListener('pointerdown', (event) => {
        if ((event.target as HTMLElement).closest('a, button')) return;
        pointerStartX = event.clientX;
      });
      carousel.addEventListener('pointerup', (event) => {
        if (pointerStartX === undefined) return;

        const swipeDistance = event.clientX - pointerStartX;
        pointerStartX = undefined;
        if (Math.abs(swipeDistance) > 48) {
          selectSlide(activeIndex + (swipeDistance < 0 ? 1 : -1));
        }
      });
      carousel.addEventListener('pointercancel', () => {
        pointerStartX = undefined;
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      });

      showSlide(0);
      startAutoplay();
    }

    initializeHeroCarousel();
  </script>
</BaseLayout>
