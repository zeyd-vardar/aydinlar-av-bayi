---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
const crumbs = [{name:'Ana Sayfa',url:'/'},{name:'Hakkımızda',url:'/hakkimizda'}];
const values = [['01','Sahadan Gelen Deneyim','Ürünleri yalnızca raf üzerinde değil, kullanım alanındaki karşılığıyla değerlendiriyoruz.'],['02','İhtiyaca Göre Rehberlik','Her kullanıcıya aynı ürünü değil, beklentisine ve kullanımına uygun seçeneği öneriyoruz.'],['03','Uzun Vadeli Güven','Satış öncesinden kullanım sonrasına uzanan samimi ve güvenilir bir ilişki kuruyoruz.']];
---
<BaseLayout title="Hakkımızda | Aydınlar Av Bayi" description="Aydınlar Av Bayi'nin doğa tutkusu, deneyimi, geniş ürün yaklaşımı ve müşterilerine sunduğu uzman desteği yakından tanıyın." breadcrumbs={crumbs} compactFooter>
  <PageHero eyebrow="Hakkımızda" title="Doğaya duyulan tutkudan doğan bir mağaza" text="Balıkçılık, avcılık ve outdoor kültürünü doğru ekipman ve sahici deneyimle buluşturuyoruz." image="/images/hunting-banner.jpg" position="center" />
  <section class="section"><div class="container story-grid"><img class="story-image" src="/images/store-interior.jpg" alt="Aydınlar Av Bayi modern mağaza içi" width="1400" height="933" loading="lazy"/><div class="story-copy"><span class="eyebrow">Hikâyemiz</span><h2>Bilgiyle seçilen ekipman, doğada fark yaratır.</h2><p>Aydınlar Av Bayi, doğada geçirilen her anın doğru hazırlıkla daha güvenli ve keyifli olduğuna inanır. Balıkçılıktan kampa uzanan geniş ürün dünyamızda, farklı deneyim seviyelerine hitap eden güvenilir seçenekleri bir araya getiriyoruz.</p><p>Amacımız yalnızca ürün göstermek değil; kullanım alanınızı dinleyip doğru seçimi yapmanıza yardımcı olmak. Gerçek mağaza hikâyesi ve kurumsal bilgiler daha sonra bu alandan kolayca güncellenebilir.</p></div></div></section>
  <section class="section alt"><div class="container"><SectionHeader eyebrow="Yaklaşımımız" title="Uzmanlık, samimiyet ve doğru yönlendirme"/><div class="values-grid">{values.map(([n,t,p]) => <article class="value-card"><span>{n}</span><h3>{t}</h3><p>{p}</p></article>)}</div></div></section>
</BaseLayout>
