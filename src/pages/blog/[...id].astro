---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogBreadcrumb from '../../components/blog/BlogBreadcrumb.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import RelatedArticles from '../../components/blog/RelatedArticles.astro';
import { siteConfig } from '../../data/siteConfig.js';
import { formatTurkishDate, getBlogPostPath, slugifyTurkish } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { id: getBlogPostPath(post.data.mainCategory, post.data.slug).replace('/blog/', '') },
    props: { post, allPosts: posts },
  }));
}
const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const related = allPosts
  .filter((item) => item.id !== post.id && item.data.mainCategory === post.data.mainCategory)
  .sort(
    (a, b) =>
      Number(b.data.subCategory === post.data.subCategory) -
      Number(a.data.subCategory === post.data.subCategory),
  )
  .slice(0, 5);
const published = formatTurkishDate(post.data.publishedAt);
const updated = formatTurkishDate(post.data.updatedAt);
const articlePath = getBlogPostPath(post.data.mainCategory, post.data.slug);
const articleUrl = new URL(articlePath, siteConfig.url).href;
const seoTitle =
  post.data.title.length > 48 ? post.data.title : `${post.data.title} | Aydınlar Av Bayi`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.image, siteConfig.url).href,
  author: { '@type': 'Organization', name: post.data.author },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', siteConfig.url).href },
  },
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.updatedAt.toISOString(),
  mainEntityOfPage: articleUrl,
  articleSection: `${post.data.mainCategory} / ${post.data.subCategory}`,
  keywords: post.data.keywords.join(', '),
};
const categorySlug = slugifyTurkish(post.data.mainCategory);
const crumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'BLOG', url: '/blog' },
  { name: post.data.mainCategory, url: `/blog?category=${categorySlug}` },
  { name: post.data.subCategory, url: `/blog?category=${categorySlug}` },
  { name: post.data.title, url: articlePath },
];
---

<BaseLayout
  title={seoTitle}
  description={post.data.description}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  breadcrumbs={crumbs}
  compactFooter
  ogType="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  author={post.data.author}
  articleSection={post.data.mainCategory}
  articleTags={post.data.tags}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />
  <article class="blog-article">
    <header class="article-header">
      <div class="container">
        <BlogBreadcrumb
          mainCategory={post.data.mainCategory}
          subCategory={post.data.subCategory}
          title={post.data.title}
        /><span class="eyebrow light">{post.data.mainCategory} · {post.data.subCategory}</span><h1>
          {post.data.title}
        </h1><p class="article-intro">{post.data.description}</p><div class="article-meta">
          <span>{post.data.author}</span><span>{published}</span><span
            >{post.data.readingTime} dk okuma</span
          >
        </div>
      </div>
    </header>
    <div class:list={['article-layout container', { 'without-toc': tocHeadings.length === 0 }]}>
      {
        tocHeadings.length > 0 && (
          <aside>
            <TableOfContents headings={tocHeadings} />
          </aside>
        )
      }
      <div class="article-main">
        <div class="article-updated">Yayın: {published} · Son güncelleme: {updated}</div>{
          post.data.officialNotice && (
            <aside
              class="official-notice"
              role="note"
            >
              <strong>Resmî bilgi notu</strong>
              <p>Güncel resmi düzenlemeyi kontrol edin.</p>
            </aside>
          )
        }<div class="blog-prose"><Content /></div>{
          post.data.sources.length > 0 && (
            <section
              class="article-sources"
              aria-labelledby="sources-title"
            >
              <h2 id="sources-title">Kaynaklar</h2>
              <ul>
                {post.data.sources.map((source) => (
                  <li>
                    <a
                      href={source.url}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <strong>{source.institution}</strong>
                      <span>{source.page}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </article>
  <RelatedArticles posts={related} />
</BaseLayout>
