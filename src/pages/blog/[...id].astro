---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogBreadcrumb from '../../components/blog/BlogBreadcrumb.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import RelatedArticles from '../../components/blog/RelatedArticles.astro';
import ManagedBlogContent from '../../components/blog/ManagedBlogContent.astro';
import { siteConfig } from '../../data/siteConfig.js';
import { formatTurkishDate, getBlogPostPath, slugifyTurkish } from '../../utils/blog';
import { serializeJsonLd } from '../../utils/jsonLd';
import { withBase } from '../../utils/paths';
import { getAllBlogPosts } from '../../utils/blogPosts';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();

  return posts.map((post) => ({
    params: { id: getBlogPostPath(post.data.mainCategory, post.data.slug).replace('/blog/', '') },
    props: { post, allPosts: posts },
  }));
}
const { post, allPosts } = Astro.props;
const rendered = post.kind === 'local' ? await render(post.entry) : null;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const sharedTerms = (left: string[], right: string[]) => {
  const rightSet = new Set(right.map((value) => value.toLocaleLowerCase('tr-TR')));
  return left.filter((value) => rightSet.has(value.toLocaleLowerCase('tr-TR'))).length;
};
const categoryPosts = allPosts
  .filter((item) => item.data.mainCategory === post.data.mainCategory)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'tr'));
const currentIndex = categoryPosts.findIndex((item) => item.id === post.id);
const previousPost = currentIndex > 0 ? categoryPosts[currentIndex - 1] : undefined;
const nextPost =
  currentIndex < categoryPosts.length - 1 ? categoryPosts[currentIndex + 1] : undefined;
const related = categoryPosts
  .filter((item) => item.id !== post.id)
  .map((item) => ({
    item,
    score:
      Number(item.data.subCategory === post.data.subCategory) * 20 +
      sharedTerms(item.data.tags, post.data.tags) * 4 +
      sharedTerms(item.data.keywords, post.data.keywords) * 2,
  }))
  .sort((a, b) => b.score - a.score || a.item.data.title.localeCompare(b.item.data.title, 'tr'))
  .slice(0, 5);
const published = formatTurkishDate(post.data.publishedAt);
const updated = formatTurkishDate(post.data.updatedAt);
const articlePath = getBlogPostPath(post.data.mainCategory, post.data.slug);
const articlePathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const articleUrl = new URL(articlePathname, siteConfig.url).href;
const conciseSeoTitles: Record<string, string> = {
  'turkiye-de-ruhsatsiz-atesli-silah-bulundurmak-veya-tasimak-yasal-midir':
    'Ruhsatsız Silah Taşımak Yasal mı?',
  '1000-2000-3000-ve-4000-lik-makine-ne-demektir': '1000–4000’lik Makine Ne Demek?',
};
const conciseTitle = conciseSeoTitles[post.data.slug] ?? post.data.title;
const brandedTitle = `${conciseTitle} | ${siteConfig.name}`;
const seoTitle = brandedTitle.length <= 60 ? brandedTitle : conciseTitle;
const productGroupFor: Record<string, { label: string; href: string }> = {
  Balıkçılık: { label: 'Balıkçılık ürün gruplarını inceleyin', href: '/urun-gruplari#balikcilik' },
  Avcılık: { label: 'Avcılık ürün gruplarını inceleyin', href: '/urun-gruplari#avcilik' },
  Kampçılık: { label: 'Kamp ürün gruplarını inceleyin', href: '/urun-gruplari#kamp' },
};
const productGroup = productGroupFor[post.data.mainCategory];
const logoUrl = new URL(withBase(siteConfig.logoPath), siteConfig.url).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(withBase(post.data.image), siteConfig.url).href,
  author: {
    '@type': 'Organization',
    '@id': `${siteConfig.url}#organization`,
    name: post.data.author,
    legalName: siteConfig.legalName,
    url: siteConfig.url,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteConfig.url}#organization`,
    name: siteConfig.name,
    legalName: siteConfig.legalName,
    url: siteConfig.url,
    logo: {
      '@type': 'ImageObject',
      url: logoUrl,
      width: siteConfig.logo.width,
      height: siteConfig.logo.height,
      encodingFormat: siteConfig.logo.type,
    },
  },
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.updatedAt.toISOString(),
  mainEntityOfPage: articleUrl,
  articleSection: `${post.data.mainCategory} / ${post.data.subCategory}`,
  keywords: post.data.keywords.join(', '),
};
const categorySlug = slugifyTurkish(post.data.mainCategory);
const crumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'BLOG', url: '/blog' },
  { name: post.data.mainCategory, url: `/blog?category=${categorySlug}` },
  { name: post.data.subCategory, url: `/blog?category=${categorySlug}` },
  { name: post.data.title, url: articlePath },
];
---

<BaseLayout
  title={seoTitle}
  description={post.data.description}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  breadcrumbs={crumbs}
  compactFooter
  ogType="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  author={post.data.author}
  articleSection={post.data.mainCategory}
  articleTags={post.data.tags}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(articleSchema)}
  />
  <article class="blog-article">
    <header class="article-header">
      <div class="container">
        <BlogBreadcrumb
          mainCategory={post.data.mainCategory}
          subCategory={post.data.subCategory}
          title={post.data.title}
        />
        <span class="eyebrow light">{post.data.mainCategory} · {post.data.subCategory}</span>
        <h1>
          {post.data.title}
        </h1>
        <p class="article-intro">{post.data.description}</p>
        <div class="article-meta">
          <span>{post.data.author}</span>
          <span>{published}</span>
          <span>{post.data.readingTime} dk okuma</span>
        </div>
      </div>
    </header>
    <div class:list={['article-layout container', { 'without-toc': tocHeadings.length === 0 }]}>
      {
        tocHeadings.length > 0 && (
          <aside>
            <TableOfContents headings={tocHeadings} />
          </aside>
        )
      }
      <div class="article-main">
        <div class="article-updated">Yayın: {published} · Son güncelleme: {updated}</div>
        {
          post.data.officialNotice && (
            <aside
              class="official-notice"
              role="note"
            >
              <strong>Mevzuat uyarısı</strong>
              <p>Güncel bilgi için yetkili kurumların resmî kaynaklarını kontrol edin.</p>
            </aside>
          )
        }
        <div class="blog-prose">
          {
            post.kind === 'managed' ? (
              <ManagedBlogContent content={post.content} />
            ) : (
              Content && <Content />
            )
          }
        </div>
        <aside
          class="article-context-links"
          aria-label="İlgili bağlantılar"
        >
          <a href={withBase(productGroup.href)}>
            {productGroup.label}
            <span aria-hidden="true">→</span>
          </a>
          <a href={withBase(`/blog#${categorySlug}`)}>
            Diğer {post.data.mainCategory.toLocaleLowerCase('tr-TR')} rehberleri
            <span aria-hidden="true">→</span>
          </a>
        </aside>
        {
          (previousPost || nextPost) && (
            <nav
              class="article-pagination"
              aria-label="Yazılar arasında gezinme"
            >
              {previousPost ? (
                <a
                  href={withBase(
                    getBlogPostPath(previousPost.data.mainCategory, previousPost.data.slug),
                  )}
                >
                  <span>← Önceki yazı</span>
                  <strong>{previousPost.data.title}</strong>
                </a>
              ) : (
                <span />
              )}
              {nextPost && (
                <a href={withBase(getBlogPostPath(nextPost.data.mainCategory, nextPost.data.slug))}>
                  <span>Sonraki yazı →</span>
                  <strong>{nextPost.data.title}</strong>
                </a>
              )}
            </nav>
          )
        }
        {
          post.data.sources.length > 0 && (
            <section
              class="article-sources"
              aria-labelledby="sources-title"
            >
              <h2 id="sources-title">Kaynaklar</h2>
              <ul>
                {post.data.sources.map((source) => (
                  <li>
                    <a
                      href={source.url}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <strong>{source.institution}</strong>
                      <span>{source.page}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </article>
  <RelatedArticles posts={related.map(({ item }) => item)} />
</BaseLayout>
