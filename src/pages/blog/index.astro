---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSearch from '../../components/blog/BlogSearch.astro';
import { getBlogPostPath, slugifyTurkish } from '../../utils/blog';
import { withBase } from '../../utils/paths';

const categoryOrder = ['Balıkçılık', 'Avcılık', 'Kampçılık'] as const;
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'tr'),
);
const groups = categoryOrder.map((mainCategory) => {
  const categoryPosts = posts.filter((post) => post.data.mainCategory === mainCategory);
  const subCategories = [...new Set(categoryPosts.map((post) => post.data.subCategory))].sort(
    (a, b) => a.localeCompare(b, 'tr'),
  );
  return {
    mainCategory,
    subCategories: subCategories.map((subCategory) => ({
      subCategory,
      posts: categoryPosts.filter((post) => post.data.subCategory === subCategory),
    })),
  };
});
const crumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'BLOG', url: '/blog' },
];
---

<BaseLayout
  title="BLOG | Aydınlar Av Bayii"
  description="Balıkçılık ekipmanı, avcılık mevzuatı, silah güvenliği, kamp hazırlığı ve outdoor yaşam hakkında pratik, anlaşılır ve kaynaklı rehberleri inceleyin."
  breadcrumbs={crumbs}
  compactFooter
>
  <header class="knowledge-hero">
    <div class="container">
      <span class="eyebrow light">BLOG</span>
      <h1>BALIKÇILIK, AVCILIK VE KAMPÇILIK BLOGU</h1>
      <p>
        Balıkçılık, avcılık, kampçılık ve doğa yaşamı hakkında merak ettiğiniz konulara güvenilir ve
        anlaşılır bilgilerle ulaşın.
      </p>
      <BlogSearch posts={posts} />
    </div>
  </header>
  <div
    class="knowledge-directory section"
    data-knowledge-directory
  >
    <div class="container">
      {
        groups.map((group) => (
          <section
            class="knowledge-main"
            id={slugifyTurkish(group.mainCategory)}
            data-main-category={slugifyTurkish(group.mainCategory)}
          >
            <div class="knowledge-main-heading">
              <span>Bilgi Alanı</span>
              <h2>{group.mainCategory}</h2>
              <p>
                {group.subCategories.reduce((total, item) => total + item.posts.length, 0)} başlık
              </p>
            </div>
            <div class="knowledge-subtopics">
              {group.subCategories.map((grouping, index) => (
                <details
                  open={index < 2}
                  id={`${slugifyTurkish(group.mainCategory)}-${slugifyTurkish(grouping.subCategory)}`}
                >
                  <summary>
                    <span>{grouping.subCategory}</span>
                    <small>{grouping.posts.length}</small>
                  </summary>
                  <ul>
                    {grouping.posts.map((post) => (
                      <li>
                        <a href={withBase(getBlogPostPath(post.data.mainCategory, post.data.slug))}>
                          <span>{post.data.title}</span>
                          <b aria-hidden="true">→</b>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
