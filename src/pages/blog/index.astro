---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSearch from '../../components/blog/BlogSearch.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import Icon from '../../components/Icon.astro';

const posts = (await getCollection('blog')).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = posts.filter((post) => post.data.featured).slice(0,3);
const popularTopics = ['Spin Balıkçılığı','Olta Kamışı Seçimi','Makine Seçimi','Sahte Yemler','Levrek','Kamp Çadırları','Uyku Tulumları','Outdoor Giyim'];
const crumbs = [{name:'Ana Sayfa',url:'/'},{name:'Blog',url:'/blog'}];
---
<BaseLayout title="Blog ve Bilgi Merkezi | Aydınlar Av Bayi" description="Balıkçılık, avcılık, kampçılık ve outdoor hakkında doğru, anlaşılır ve faydalı rehberlere ulaşın." breadcrumbs={crumbs} compactFooter>
  <section class="blog-hero">
    <img src="/images/hero-fishing.jpg" alt="" width="1920" height="1004" fetchpriority="high" />
    <div class="container"><span class="eyebrow light">Blog · Bilgi Merkezi</span><h1>Doğaya Dair<br/>Merak Ettikleriniz</h1><p>Balıkçılık, avcılık ve kampçılık hakkında doğru, güvenilir ve faydalı bilgilere kolayca ulaşın.</p><BlogSearch /></div>
  </section>

  <section class="blog-featured section"><div class="container"><div class="section-head"><span class="eyebrow">Öne Çıkan İçerikler</span><h2>Başlangıç için en faydalı rehberler</h2></div><div class="featured-blog-grid">{featured.map((post,index) => <BlogCard post={post} featured={index===0} index={index}/>)}</div></div></section>

  <section class="popular-topics"><div class="container"><span>Popüler Konular</span><div>{popularTopics.map((topic) => <a href={`/blog?q=${encodeURIComponent(topic)}`}>{topic}<Icon name="arrow" size={14}/></a>)}</div></div></section>

  <section class="section blog-all" id="tum-yazilar"><div class="container"><div class="section-head"><span class="eyebrow">Son Eklenen Yazılar</span><h2>Bilginizi sahada güçlendirin</h2><p>Temel kavramlardan ekipman seçimine kadar, kolay okunabilen pratik içerikler.</p></div><div class="blog-grid" data-blog-grid>{posts.map((post,index) => <BlogCard post={post} index={index}/>)}</div></div></section>
</BaseLayout>
