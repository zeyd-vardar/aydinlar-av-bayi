---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { responsiveImageSrcSet, withBase } from '../utils/paths';
const crumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Mağazamız', url: '/magazamiz' },
];
const items = [
  { src: '/images/galer1.webp', width: 1386, height: 1046 },
  { src: '/images/galeri2.webp', width: 1386, height: 650 },
  { src: '/images/galeri3.webp', width: 832, height: 1102 },
  { src: '/images/galeri4.webp', width: 830, height: 1098 },
  { src: '/images/galeri5.webp', width: 1396, height: 650 },
  { src: '/images/galeri6.webp', width: 832, height: 1100 },
  { src: '/images/galeri7.webp', width: 500, height: 1104 },
  { src: '/images/galeri8.webp', width: 826, height: 1100 },
  { src: '/images/galeri9.webp', width: 830, height: 1106 },
  { src: '/images/galeri10.webp', width: 742, height: 990 },
  { src: '/images/galeri11.webp', width: 824, height: 1098 },
  { src: '/images/galeri12.webp', width: 830, height: 1104 },
  { src: '/images/galeri13.webp', width: 828, height: 1100 },
  { src: '/images/galeri14.webp', width: 826, height: 1108 },
  { src: '/images/galeri15.webp', width: 826, height: 1102 },
  { src: '/images/galeri16.webp', width: 826, height: 1096 },
  { src: '/images/galeri17.webp', width: 1400, height: 638 },
];
---

<BaseLayout
  title="Mağazamız | Aydınlar Av Bayii"
  description="Trabzon Ortahisar'daki Aydınlar Av Bayii mağazasını; balıkçılık, avcılık, kamp ve outdoor ürünlerinin yer aldığı fotoğraf galerisiyle yakından inceleyin."
  breadcrumbs={crumbs}
  compactFooter
>
  <PageHero
    eyebrow="Mağazamız"
    title="Mağazadan ve doğadan kareler"
    text="Ekipman, mağaza ve açık hava dünyamızı yakından keşfedin."
    image="/images/hero-fishing.webp"
    position="center 60%"
  />
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Görsel Günlük"
        title="Tutkunun ayrıntılarına yakından bakın"
        text="Mağaza atmosferinden açık havadaki kullanım anlarına uzanan seçkimiz."
      /><div class="gallery-grid">
        {
          items.map((item, index) => (
            <a
              class={`gallery-item gallery-item-${index + 1}`}
              href={withBase(item.src)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Mağazamızdan ${index + 1}. fotoğrafı aç`}
            >
              <img
                src={withBase(item.src)}
                srcset={responsiveImageSrcSet(
                  item.src,
                  item.width >= 960 ? [480, 960] : [480],
                  item.width,
                )}
                sizes="(max-width: 720px) calc(100vw - 28px), (max-width: 1180px) 50vw, 580px"
                alt={`Aydınlar Av Bayii mağazasından ${index + 1}. görünüm`}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
              />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
