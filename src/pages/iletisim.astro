---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../data/siteConfig.js';
const crumbs = [{name:'Ana Sayfa',url:'/'},{name:'İletişim',url:'/iletisim'}];
const message = encodeURIComponent('Merhaba, ürünleriniz hakkında bilgi almak istiyorum.');
---
<BaseLayout title="İletişim ve Mağaza Bilgileri | Aydınlar Av Bayi" description="Aydınlar Av Bayi adres, telefon, WhatsApp ve çalışma saatleri. Mağazamızı ziyaret edin veya hızlıca iletişime geçin." breadcrumbs={crumbs}>
  <PageHero eyebrow="İletişim" title="Sorunuz varsa, deneyimimiz yanınızda" text="Ürün seçimi, mağaza ziyareti ve güncel bilgi için bize dilediğiniz kanaldan ulaşın." />
  <section class="section"><div class="container contact-grid"><div><div class="contact-cards"><div class="contact-card"><Icon name="phone"/><div><h3>Telefon</h3><a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a></div></div><div class="contact-card"><Icon name="whatsapp"/><div><h3>WhatsApp</h3><a href={`https://wa.me/${siteConfig.whatsapp}?text=${message}`} target="_blank" rel="noopener">WhatsApp ile İletişime Geç</a></div></div><div class="contact-card"><Icon name="pin"/><div><h3>Adres</h3><p>{siteConfig.address}</p></div></div><div class="contact-card"><Icon name="clock"/><div><h3>Çalışma Saatleri</h3>{siteConfig.hours.map((h) => <p>{h.days}: {h.time}</p>)}</div></div></div><div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap"><a class="btn btn-dark" href={`tel:${siteConfig.phoneHref}`}><Icon name="phone"/> Bizi Arayın</a><a class="btn btn-gold" href={`https://wa.me/${siteConfig.whatsapp}?text=${message}`} target="_blank" rel="noopener"><Icon name="whatsapp"/> WhatsApp</a></div></div><div class="map-placeholder" role="img" aria-label="Google Maps harita alanı"><span>GOOGLE MAPS ALANI</span></div></div></section>
</BaseLayout>
