---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../data/siteConfig.js';
const crumbs = [{name:'Ana Sayfa',url:'/'},{name:'İletişim',url:'/iletisim'}];
const message = encodeURIComponent('Merhaba, ürünleriniz hakkında bilgi almak istiyorum.');
---
<BaseLayout title="İletişim ve Mağaza Bilgileri | Aydınlar Av Bayi" description="Aydınlar Av Bayi adres, telefon, WhatsApp ve çalışma saatleri. Mağazamızı ziyaret edin veya hızlıca iletişime geçin." breadcrumbs={crumbs} compactFooter>
  <PageHero eyebrow="İletişim" title="Sorunuz varsa, deneyimimiz yanınızda" text="Ürün seçimi, mağaza ziyareti ve güncel bilgi için bize dilediğiniz kanaldan ulaşın." image="/images/store-interior.jpg" position="center 45%" />
  <section class="section"><div class="container contact-grid"><div><div class="contact-cards"><div class="contact-card"><Icon name="phone"/><div><h3>Telefon</h3><a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a></div></div><div class="contact-card contact-card-whatsapp"><Icon name="whatsapp"/><div><h3>WhatsApp</h3><a href={`https://wa.me/${siteConfig.whatsapp}?text=${message}`} target="_blank" rel="noopener">WhatsApp ile İletişime Geç</a></div></div><div class="contact-card"><Icon name="pin"/><div><h3>Mağaza Konumu</h3><p>{siteConfig.address}</p><a class="map-text-link" href={siteConfig.mapUrl} target="_blank" rel="noopener">Konumu Google Maps'te aç</a></div></div><div class="contact-card"><Icon name="clock"/><div><h3>Çalışma Saatleri</h3>{siteConfig.hours.map((h) => <p>{h.days}: {h.time}</p>)}</div></div></div><div class="contact-actions"><a class="btn btn-dark" href={`tel:${siteConfig.phoneHref}`}><Icon name="phone"/> Bizi Arayın</a><a class="btn btn-gold" href={siteConfig.mapUrl} target="_blank" rel="noopener"><Icon name="pin"/> Yol Tarifi Al</a><a class="btn btn-whatsapp" href={`https://wa.me/${siteConfig.whatsapp}?text=${message}`} target="_blank" rel="noopener"><Icon name="whatsapp"/> WhatsApp</a><a class="btn btn-instagram" href={siteConfig.socials.instagram} target="_blank" rel="noopener"><Icon name="instagram"/> Instagram</a></div></div><div class="map-placeholder map-embed"><iframe src={siteConfig.mapEmbedUrl} title="Aydınlar Av Bayi mağaza konumu" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><a class="map-directions" href={siteConfig.mapUrl} target="_blank" rel="noopener"><Icon name="pin" size={17}/> Yol Tarifi Al</a></div></div></section>
</BaseLayout>
