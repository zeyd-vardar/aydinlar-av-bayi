---
import { siteConfig } from '../data/siteConfig.js';
import Icon from './Icon.astro';
const message = encodeURIComponent('Merhaba, ürünleriniz hakkında bilgi almak istiyorum.');
---
<a class="whatsapp-float" href={`https://wa.me/${siteConfig.whatsapp}?text=${message}`} target="_blank" rel="noopener" aria-label="WhatsApp ile iletişime geç"><Icon name="whatsapp" size={23}/><span>WhatsApp</span></a>
