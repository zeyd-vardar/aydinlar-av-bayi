---
const {
  eyebrow,
  title,
  text,
  image = '/images/hero-fishing.webp',
  position = 'center',
} = Astro.props;
---

<section class="page-hero">
  <img
    src={image}
    alt=""
    width="1920"
    height="1080"
    style={`object-position:${position}`}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="container">
    <span class="eyebrow light">{eyebrow}</span><h1>{title}</h1><p>{text}</p>
  </div>
</section>
