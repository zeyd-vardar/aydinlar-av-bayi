---
import { responsiveImageSrcSet, withBase } from '../utils/paths';

const {
  eyebrow,
  title,
  text,
  image = '/images/hero-fishing.webp',
  position = 'center',
} = Astro.props;
const imageDimensions: Record<string, { width: number; height: number }> = {
  '/images/hero-fishing.webp': { width: 1920, height: 1080 },
  '/images/hunting-banner.webp': { width: 1920, height: 800 },
  '/images/store-interior.webp': { width: 1400, height: 933 },
  '/images/category-atlas.webp': { width: 2000, height: 711 },
};
const dimensions = imageDimensions[image] ?? { width: 1920, height: 1080 };
---

<section class="page-hero">
  <img
    src={withBase(image)}
    srcset={responsiveImageSrcSet(image, [768, 1280], dimensions.width)}
    sizes="100vw"
    alt=""
    width={dimensions.width}
    height={dimensions.height}
    style={`object-position:${position}`}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="container">
    <span class="eyebrow light">{eyebrow}</span>
    <h1>{title}</h1>
    <p>{text}</p>
  </div>
</section>
