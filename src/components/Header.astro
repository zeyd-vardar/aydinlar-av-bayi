---
import { navLinks, siteConfig } from '../data/siteConfig.js';
import Icon from './Icon.astro';
import { withBase } from '../utils/paths';
const comparablePath = (path: string) => path.replace(/\/+$/, '') || '/';
const current = comparablePath(Astro.url.pathname);
const storePath = withBase('/magazamiz');
const headerLinks = navLinks.filter((link) => link.href !== storePath);
---

<header
  class="site-header over-hero"
  data-header
>
  <div class="container nav-wrap">
    <a
      class="brand"
      href={withBase('/')}
    >
      <span class="brand-logo-frame"
        ><img
          class="brand-logo"
          src={withBase(siteConfig.logoPath)}
          width={siteConfig.logo.width}
          height={siteConfig.logo.height}
          alt=""
          decoding="async"
        /></span
      ><span><b>{siteConfig.shortName}</b><small>AV • BALIK • OUTDOOR</small></span>
    </a>
    <nav
      class="desktop-nav"
      aria-label="Ana menü"
    >
      {
        headerLinks.map((link) => (
          <a
            href={link.href}
            aria-current={current === comparablePath(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <a
      class="btn btn-gold nav-cta"
      href={storePath}
      aria-current={current === comparablePath(storePath) ? 'page' : undefined}
      >Mağazamız <Icon
        name="arrow"
        size={17}
      /></a
    >
    <button
      class="menu-toggle"
      type="button"
      aria-label="Menüyü aç"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
      ><Icon name="menu" /></button
    >
  </div>
  <nav
    id="mobile-menu"
    class="mobile-nav"
    aria-label="Mobil menü"
    data-mobile-menu
    hidden
  >
    <div class="container">
      {
        headerLinks.map((link) => (
          <a
            href={link.href}
            aria-current={current === comparablePath(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        class="btn btn-gold"
        href={storePath}
        aria-current={current === comparablePath(storePath) ? 'page' : undefined}
        ><Icon
          name="arrow"
          size={18}
        /> Mağazamız</a
      >
      <a
        class="btn btn-gold"
        href={`tel:${siteConfig.phoneHref}`}
        ><Icon
          name="phone"
          size={18}
        /> Bizi Arayın</a
      >
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (header) {
    const updateHeaderStyle = () => header.classList.toggle('scrolled', window.scrollY > 24);
    updateHeaderStyle();
    window.addEventListener('scroll', updateHeaderStyle, { passive: true });
  }

  if (menuButton && mobileMenu) {
    const setMenuOpen = (isOpen: boolean) => {
      menuButton.setAttribute('aria-expanded', String(isOpen));
      menuButton.setAttribute('aria-label', isOpen ? 'Menüyü kapat' : 'Menüyü aç');
      mobileMenu.hidden = !isOpen;
      document.body.classList.toggle('menu-open', isOpen);
    };

    menuButton.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isOpen);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || menuButton.getAttribute('aria-expanded') !== 'true') return;
      setMenuOpen(false);
      menuButton.focus();
    });
  }
</script>
