---
import Icon from '../Icon.astro';
const { post, featured = false, index = 0 } = Astro.props;
const date = post.data.publishedAt.toLocaleDateString('tr-TR', { day:'numeric', month:'long', year:'numeric' });
const searchText = [post.data.title, post.data.description, post.data.category, ...post.data.tags, ...post.data.keywords].join(' ');
---
<article class:list={['blog-card', { featured }]} data-blog-card data-post-id={post.id} data-search={searchText} data-category={post.data.category}>
  <a class="blog-card-link" href={`/blog/${post.id}`} aria-label={`${post.data.title} yazısını oku`}>
    <span class={`blog-card-image crop-${index % 4}`} style={`background-image:linear-gradient(180deg,transparent 50%,rgba(5,10,7,.48)),url('${post.data.image}')`} role="img" aria-label={post.data.imageAlt}></span>
    <span class="blog-card-body">
      <span class="blog-card-category">{post.data.category}</span>
      <strong>{post.data.title}</strong>
      <span class="blog-card-description">{post.data.description}</span>
      <span class="blog-card-meta"><span>{date} · {post.data.readingTime} dk okuma</span><span class="circle-arrow"><Icon name="arrow" size={16}/></span></span>
    </span>
  </a>
</article>
