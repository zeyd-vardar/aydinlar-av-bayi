---
import type { CollectionEntry } from 'astro:content';
import { getBlogPostPath } from '../../utils/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section
      class="related-articles"
      aria-labelledby="related-title"
    >
      <div class="container">
        <span class="eyebrow">İlgili İçerikler</span>
        <h2 id="related-title">Bunlar da ilginizi çekebilir</h2>
        <ul>
          {posts.map((post) => (
            <li>
              <a href={getBlogPostPath(post.data.mainCategory, post.data.slug)}>
                <span>{post.data.subCategory}</span>
                <strong>{post.data.title}</strong>
                <b aria-hidden="true">→</b>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
