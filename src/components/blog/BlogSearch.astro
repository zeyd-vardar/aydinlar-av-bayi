---
import type { CollectionEntry } from 'astro:content';
import { getBlogPostPath } from '../../utils/blog';
import { withBase } from '../../utils/paths';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

<div
  class="blog-discovery"
  data-blog-discovery
>
  <form
    class="blog-search"
    role="search"
    data-blog-search-form
  >
    <label for="blog-search-input">BLOG'da arayın</label>
    <div class="blog-search-field">
      <span aria-hidden="true">⌕</span>
      <input
        id="blog-search-input"
        type="search"
        name="q"
        placeholder="Merak ettiğiniz konuyu arayın..."
        autocomplete="off"
        data-blog-search-input
      />
      <button type="submit">Ara</button>
    </div>
  </form>
  <div
    class="blog-results-summary"
    aria-live="polite"
    data-results-summary
    hidden
  >
  </div>
  <ul
    class="knowledge-results"
    data-search-results
    hidden
  >
    {
      posts.map((post) => (
        <li
          data-search-result
          data-search={[
            post.data.title,
            post.data.description,
            post.data.mainCategory,
            post.data.subCategory,
            ...post.data.tags,
            ...post.data.keywords,
          ].join(' ')}
        >
          <a href={withBase(getBlogPostPath(post.data.mainCategory, post.data.slug))}>
            <span>
              {post.data.mainCategory} / {post.data.subCategory}
            </span>
            <strong>{post.data.title}</strong>
          </a>
        </li>
      ))
    }
  </ul>
  <div
    class="blog-empty"
    data-blog-empty
    hidden
  >
    <h2>Aradığınız konuyla ilgili henüz bir içerik bulunamadı.</h2>
    <p>Farklı bir kelime deneyebilir veya bilgi dizinine geri dönebilirsiniz.</p>
    <button
      class="btn btn-dark"
      type="button"
      data-reset-search
      >Bilgi Dizinini Göster</button
    >
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-blog-discovery]');

  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-blog-search-input]');
    const form = root.querySelector<HTMLFormElement>('[data-blog-search-form]');
    const emptyState = root.querySelector<HTMLElement>('[data-blog-empty]');
    const summary = root.querySelector<HTMLElement>('[data-results-summary]');
    const resetButton = root.querySelector<HTMLButtonElement>('[data-reset-search]');
    const resultsList = root.querySelector<HTMLElement>('[data-search-results]');
    const results = [...root.querySelectorAll<HTMLElement>('[data-search-result]')];
    const directory = document.querySelector<HTMLElement>('[data-knowledge-directory]');
    const categorySections = [...document.querySelectorAll<HTMLElement>('[data-main-category]')];

    const normalizeText = (value: string) =>
      value
        .toLocaleLowerCase('tr-TR')
        .replace(/ı/g, 'i')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

    const updateSearch = (updateUrl = true) => {
      const query = input?.value.trim() ?? '';
      const normalizedQuery = normalizeText(query);
      let matchCount = 0;

      results.forEach((result) => {
        const searchText = normalizeText(result.dataset.search ?? '');
        const matches = normalizedQuery !== '' && searchText.includes(normalizedQuery);
        result.hidden = !matches;
        if (matches) matchCount += 1;
      });

      if (directory) directory.hidden = normalizedQuery !== '';
      if (resultsList) resultsList.hidden = normalizedQuery === '';
      if (emptyState) emptyState.hidden = normalizedQuery === '' || matchCount > 0;
      if (summary) {
        summary.hidden = normalizedQuery === '';
        summary.textContent = `“${query}” için ${matchCount} içerik bulundu.`;
      }

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        history.replaceState({}, '', url);
      }
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      updateSearch();
    });
    input?.addEventListener('input', () => updateSearch());
    resetButton?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      updateSearch();
      input.focus();
    });

    const searchParams = new URLSearchParams(window.location.search);
    const initialQuery = searchParams.get('q') ?? '';
    const selectedCategory = searchParams.get('category');

    if (input) input.value = initialQuery;
    if (selectedCategory) {
      categorySections.forEach((section) => {
        section.hidden = section.dataset.mainCategory !== selectedCategory;
      });
    }
    if (initialQuery) updateSearch(false);
  }
</script>
