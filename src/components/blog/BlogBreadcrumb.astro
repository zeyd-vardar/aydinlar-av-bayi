---
import { slugifyTurkish } from '../../utils/blog';
import { withBase } from '../../utils/paths';

const { mainCategory, subCategory, title } = Astro.props;
const categorySlug = slugifyTurkish(mainCategory);
const subCategorySlug = slugifyTurkish(subCategory);
---

<nav
  class="blog-breadcrumb"
  aria-label="İçerik yolu"
>
  <ol>
    <li><a href={withBase('/')}>Ana Sayfa</a></li>
    <li><a href={withBase('/blog')}>BLOG</a></li>
    <li>
      <a href={withBase(`/blog?category=${categorySlug}`)}>{mainCategory}</a>
    </li>
    <li>
      <a href={withBase(`/blog?category=${categorySlug}#${categorySlug}-${subCategorySlug}`)}
        >{subCategory}</a
      >
    </li>
    <li aria-current="page">{title}</li>
  </ol>
</nav>
