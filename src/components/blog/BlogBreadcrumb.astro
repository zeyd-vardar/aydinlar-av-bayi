---
const { category, title } = Astro.props;
const categorySlug = category.toLocaleLowerCase('tr-TR').replace(/ı/g,'i').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replaceAll(' ','-');
---
<nav class="blog-breadcrumb" aria-label="İçerik yolu"><ol><li><a href="/">Ana Sayfa</a></li><li><a href="/blog">Blog</a></li><li><a href={`/blog?category=${categorySlug}`}>{category}</a></li><li aria-current="page">{title}</li></ol></nav>
